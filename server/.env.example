# OpenRouter OpenAI-Compatible Vision API Configuration
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_API_KEY=your_openrouter_api_key_here
MODEL_ID=dots-studio/dots-3-note-preview:free

# Supabase Configuration (Enables server-authoritative token verification & save endpoint)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-Only Service Role Key (Used exclusively by server/index.js for atomic progression RPC)
# NEVER expose this key to Vite (client/.env) or frontend bundles.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-Authoritative Cryptographic Loot Signing (Required in production, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOOT_SIGNING_SECRET=your_32_byte_hex_signing_secret_here